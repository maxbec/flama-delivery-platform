name: Flama Auto Merge

on:
  pull_request:
    types: [opened, reopened, ready_for_review, synchronize]
    branches: [dev]

permissions:
  contents: write
  pull-requests: write

jobs:
  auto-merge:
    uses: maxbec/flama-delivery-platform/.github/workflows/reusable-auto-merge.yml@__FLAMA_PLATFORM_REF__
    with:
      profile: major
      release-branch: main
