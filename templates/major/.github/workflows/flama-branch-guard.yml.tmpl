name: Flama Branch Guard

on:
  pull_request:
    branches: [dev, main]

permissions:
  contents: read

jobs:
  branch-guard:
    uses: maxbec/flama-delivery-platform/.github/workflows/reusable-branch-guard.yml@__FLAMA_PLATFORM_REF__
    with:
      head-sha: ${{ github.event.pull_request.head.sha }}
      profile: major
      runner-labels: ${{ vars.PIPELINE_RUNNER || '["ubuntu-latest"]' }}
