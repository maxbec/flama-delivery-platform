name: Flama Preflight

# Publishes the App-authored `Flama Preflight` check for every feature pull
# request: the head's own `./scripts/delivery buildable` and `affected`, run
# from a clean checkout of the exact commit and attested by the owner's Flama
# delivery App. The gates require that check; this is what produces it,
# without any machine outside GitHub in the loop. Where the sweep on ai-vm
# still runs it publishes the same check first for some heads, and this
# workflow then finds nothing to do.
#
# `workflow_run` starts a workflow only from the default branch, so this file
# has to be there to fire at all — and that is the point: a pull request
# cannot rewrite the publisher that judges it. The change runs in a job that
# holds no credential and no identity; only the platform's own jobs request
# the short-lived OIDC identity that reads the App credential from Infisical.

on:
  workflow_run:
    workflows: [Flama Branch Guard]
    types: [completed]

permissions:
  contents: read
  checks: read
  pull-requests: read
  # Requested by the platform's scope and publish jobs alone, to authenticate
  # to Infisical as this repository; the job that runs the change gets none.
  id-token: write

jobs:
  preflight:
    # Only a pull request from this repository whose Branch Guard passed. A
    # fork head is never built here; a head that failed the branch boundary
    # cannot merge and is not worth a build.
    if: >-
      ${{ github.event.workflow_run.event == 'pull_request'
        && github.event.workflow_run.conclusion == 'success'
        && github.event.workflow_run.head_repository.full_name == github.repository }}
    uses: maxbec/flama-delivery-platform/.github/workflows/reusable-preflight.yml@__FLAMA_PLATFORM_REF__
    with:
      head-sha: ${{ github.event.workflow_run.head_sha }}
      base-branch: main
      app-slug: __FLAMA_PAPERCLIP_APP_SLUG__
      platform-sha: __FLAMA_PLATFORM_REF__
      # The head is this repository's own, checked above, so the homelab
      # runner is safe for it — the same rule the other gates apply.
      runner-labels: ${{ vars.PIPELINE_RUNNER || '["ubuntu-latest"]' }}
      # Where the owner's App credential lives, rendered from platform policy.
      infisical-identity-id: __FLAMA_PREFLIGHT_INFISICAL_IDENTITY_ID__
      infisical-domain: __FLAMA_PREFLIGHT_INFISICAL_DOMAIN__
      infisical-local-domain: __FLAMA_PREFLIGHT_INFISICAL_LOCAL_DOMAIN__
      infisical-project-slug: __FLAMA_PREFLIGHT_INFISICAL_PROJECT_SLUG__
      infisical-env-slug: __FLAMA_PREFLIGHT_INFISICAL_ENV_SLUG__
      infisical-secret-path: __FLAMA_PREFLIGHT_INFISICAL_SECRET_PATH__
      app-credential-suffix: __FLAMA_PREFLIGHT_APP_CREDENTIAL_SUFFIX__
    # The Cloudflare Access service token in front of the public Infisical
    # host, forwarded by name exactly as the universal pipeline forwards it;
    # empty where it does not exist, and unused on the homelab runners, which
    # reach Infisical on the LAN. Blanket inheritance stays forbidden.
    secrets:
      CF_ACCESS_CLIENT_ID: ${{ secrets.CF_ACCESS_CLIENT_ID }}
      CF_ACCESS_CLIENT_SECRET: ${{ secrets.CF_ACCESS_CLIENT_SECRET }}
