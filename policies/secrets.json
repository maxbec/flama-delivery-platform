{
  "version": 1,
  "sourceOfTruth": "infisical",
  "deliveryPriority": [
    "oidc_runtime_retrieval",
    "workload_retrieval",
    "process_injection",
    "infisical_secret_sync",
    "approved_destination_exception"
  ],
  "publicPullRequest": {
    "secrets": "deny",
    "oidc": "deny",
    "infisical": "deny",
    "trustedCacheWrite": "deny",
    "productionNetwork": "deny",
    "privateRunner": "deny",
    "pullRequestTarget": "deny"
  },
  "trustedJobs": {
    "hardcodedOidcClaims": true,
    "shortLivedIdentity": true,
    "leastPrivilegePath": true,
    "productionAfterApprovalOnly": true,
    "broadSecretInheritance": "deny"
  },
  "machineIdentity": {
    "method": "oidc",
    "shortLived": true,
    "sharedAcrossRepositories": false,
    "scope": ["project", "environment", "path"],
    "exactClaims": ["issuer", "audience", "repository", "workflow", "ref_or_environment"]
  },
  "secretSync": {
    "allRepositories": "deny",
    "keySelection": "explicit",
    "automaticRotation": true,
    "connectionCredentialSource": "infisical",
    "initialOverwritePolicyRequired": true
  },
  "plaintext": {
    "source": "deny",
    "arguments": "deny",
    "logs": "deny",
    "cache": "deny",
    "artifacts": "deny",
    "summaries": "deny",
    "snapshots": "deny"
  }
}
