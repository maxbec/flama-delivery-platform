{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/paperclip-binding-result.schema.json",
  "title": "Secret-minimized Paperclip repository binding result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "disposition", "bindingDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["planned", "applied"] },
    "disposition": { "enum": ["planned", "created", "refreshed", "reused"] },
    "bindingDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "status": { "const": "planned" } }, "required": ["status"] },
      "then": { "type": "object", "properties": { "disposition": { "const": "planned" } } }
    },
    {
      "if": { "type": "object", "properties": { "status": { "const": "applied" } }, "required": ["status"] },
      "then": { "type": "object", "properties": { "disposition": { "enum": ["created", "refreshed", "reused"] } } }
    }
  ]
}
