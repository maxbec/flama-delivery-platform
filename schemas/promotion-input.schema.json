{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/promotion-input.schema.json",
  "title": "Exact-SHA Major profile promotion input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "profile", "publisher", "promotion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nameWithOwner", "disposition", "mutationAllowed", "isFork", "isArchived"],
      "properties": {
        "nameWithOwner": { "type": "string", "pattern": "^(maxbec|navigaite|edilio)/[A-Za-z0-9._-]+$" },
        "disposition": { "const": "in_scope" },
        "mutationAllowed": { "const": true },
        "isFork": { "const": false },
        "isArchived": { "const": false }
      }
    },
    "profile": { "const": "major" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "appSlug", "tokenScope", "apiVersion"],
      "properties": {
        "controller": { "enum": ["maxbec-delivery-controller", "navigaite-delivery-controller", "edilio-delivery-controller"] },
        "appSlug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$" },
        "tokenScope": { "const": "single-repository-pull-requests-write" },
        "apiVersion": { "const": "2026-03-10" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBranch", "targetBranch", "sourceSha", "targetSha", "integrationEvidenceDigest"],
      "properties": {
        "sourceBranch": { "const": "dev" },
        "targetBranch": { "const": "main" },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "integrationEvidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
