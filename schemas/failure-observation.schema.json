{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/failure-observation.schema.json",
  "title": "Classified delivery failure observation",
  "$comment": "Metadata only. A failure message, log excerpt, path, or command line is never accepted here; the signature is a digest of the normalized fingerprint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "classification", "signature", "attempt", "recentSameSignatureFailures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stage": { "enum": ["preflight", "final", "release", "deployment"] },
    "classification": {
      "enum": [
        "deterministic",
        "flaky_test",
        "transient_infrastructure",
        "deployment_health",
        "secret_exposure",
        "blocked_destructive_migration",
        "pooled_budget_critical",
        "platform_integrity"
      ]
    },
    "signature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
    "recentSameSignatureFailures": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "openIncidentSignature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
