{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/publish-check-result.schema.json",
  "title": "Secret-minimized Paperclip Preflight publication result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "headSha", "evidenceDigest", "check"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["planned", "published"] },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "externalId", "status", "conclusion"],
      "properties": {
        "name": { "const": "Paperclip Preflight" },
        "externalId": { "type": "string", "pattern": "^paperclip-preflight:sha256:[0-9a-f]{64}$" },
        "status": { "const": "completed" },
        "conclusion": { "const": "success" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkRunId", "appSlug", "reused"],
      "properties": {
        "checkRunId": { "type": "integer", "minimum": 1 },
        "appSlug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$" },
        "reused": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "planned" } }, "required": ["status"] },
      "then": { "properties": { "publication": false } }
    },
    {
      "if": { "properties": { "status": { "const": "published" } }, "required": ["status"] },
      "then": { "required": ["publication"] }
    }
  ]
}
