{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/secret-exceptions.schema.json",
  "title": "Approved non-Infisical destination secret exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "secretExceptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "secretExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "destination", "reason", "owner", "scope", "rotationDays", "expiresAt", "reviewAfter", "status"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "destination": { "enum": ["github_actions_secret", "github_dependabot_secret", "github_environment_secret", "provider_native_secret"] },
          "reason": { "type": "string", "minLength": 20 },
          "owner": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["repository", "environment", "provider"] },
          "rotationDays": { "type": "integer", "minimum": 1, "maximum": 365 },
          "expiresAt": { "type": "string", "format": "date" },
          "reviewAfter": { "type": "string", "format": "date" },
          "status": { "const": "approved" }
        }
      }
    }
  }
}
