{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/reconciliation-input.schema.json",
  "title": "Read-only company reconciliation audit input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "company", "controller", "controls", "mutationAllowed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "enum": ["Private", "// Navigaite", "Edilio"] }
      }
    },
    "controller": { "enum": ["maxbec-delivery-controller", "navigaite-delivery-controller", "edilio-delivery-controller"] },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueLagSeconds", "staleClaimSeconds", "authorizationExpiryWarningSeconds", "lookbackSeconds", "maximumAuthorizationRecords"],
      "properties": {
        "queueLagSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "staleClaimSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "authorizationExpiryWarningSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "lookbackSeconds": { "type": "integer", "minimum": 3600, "maximum": 604800 },
        "maximumAuthorizationRecords": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "mutationAllowed": { "const": false }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "company": { "type": "object", "properties": { "name": { "const": "Private" } }, "required": ["name"] } }, "required": ["company"] },
      "then": { "type": "object", "properties": { "controller": { "const": "maxbec-delivery-controller" } } }
    },
    {
      "if": { "type": "object", "properties": { "company": { "type": "object", "properties": { "name": { "const": "// Navigaite" } }, "required": ["name"] } }, "required": ["company"] },
      "then": { "type": "object", "properties": { "controller": { "const": "navigaite-delivery-controller" } } }
    },
    {
      "if": { "type": "object", "properties": { "company": { "type": "object", "properties": { "name": { "const": "Edilio" } }, "required": ["name"] } }, "required": ["company"] },
      "then": { "type": "object", "properties": { "controller": { "const": "edilio-delivery-controller" } } }
    }
  ]
}
