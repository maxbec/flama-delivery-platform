{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/rollback-input.schema.json",
  "title": "Operator-initiated immutable rollback input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "current", "target", "verification", "migration", "authorization"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["docker-compose", "vercel-prebuilt", "digitalocean-app", "digitalocean-droplet", "hostinger-vps", "coolify", "render", "custom"] }
      }
    },
    "current": { "$ref": "#/$defs/revision" },
    "target": { "$ref": "#/$defs/revision" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "soakSeconds"],
      "properties": {
        "expectedVersion": { "type": "string", "minLength": 1 },
        "soakSeconds": { "type": "integer", "minimum": 600 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollbackCompatible"],
      "properties": {
        "rollbackCompatible": { "type": "boolean" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drill", "incidentRef"],
      "properties": {
        "drill": { "type": "boolean" },
        "incidentRef": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "$comment": "A production rollback is never anonymous; only a drill may omit the incident reference.",
      "if": {
        "type": "object",
        "properties": { "authorization": { "type": "object", "properties": { "drill": { "const": false } }, "required": ["drill"] } },
        "required": ["authorization"]
      },
      "then": {
        "type": "object",
        "properties": {
          "authorization": {
            "type": "object",
            "properties": { "incidentRef": { "type": "string", "minLength": 1 } },
            "required": ["incidentRef"]
          }
        }
      }
    }
  ],
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "digest"],
          "properties": {
            "uri": { "type": "string", "minLength": 1, "not": { "pattern": ":latest$" } },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
