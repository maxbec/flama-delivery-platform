{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/github-policy-repair-plan.schema.json",
  "title": "GitHub policy repair plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "profile", "contractDigest", "repairs", "remediationCases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["compliant", "planned", "mutation_denied"] },
    "profile": { "enum": ["fast", "major"] },
    "contractDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "location", "disposition", "effect"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "location": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{2,31}$" },
          "disposition": { "const": "auto_repair" },
          "effect": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "remediationCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "location", "disposition", "reason"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "location": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{2,31}$" },
          "disposition": { "const": "remediation_case" },
          "reason": { "enum": ["mutation_denied", "contract_invalid", "breaks_existing_refs", "external_identity", "infrastructure", "repository_owned_content", "unclassified"] }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "A denied scope or invalid contract repairs nothing at all.",
      "if": { "properties": { "status": { "const": "mutation_denied" } }, "required": ["status"] },
      "then": { "properties": { "repairs": { "type": "array", "maxItems": 0 } } }
    },
    {
      "$comment": "A compliant plan has nothing to do.",
      "if": { "properties": { "status": { "const": "compliant" } }, "required": ["status"] },
      "then": {
        "properties": {
          "repairs": { "type": "array", "maxItems": 0 },
          "remediationCases": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
