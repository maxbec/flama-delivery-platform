{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/github-policy-repair-input.schema.json",
  "title": "GitHub policy repair planning input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "contractDigest", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "enum": ["fast", "major"] },
    "contractDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "location"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "location": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{2,31}$" }
        }
      }
    }
  }
}
