{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/governance-input.schema.json",
  "title": "Private input for a read-only Flama governance collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "window", "scopes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "company", "githubOwner", "controller", "paperclipAttestation", "repositories"],
        "properties": {
          "key": { "enum": ["maxbec", "navigaite", "edilio"] },
          "company": { "enum": ["Private", "// Navigaite", "Edilio"] },
          "githubOwner": { "enum": ["maxbec", "navigaite", "edilio"] },
          "controller": {
            "enum": [
              "maxbec-delivery-controller",
              "navigaite-delivery-controller",
              "edilio-delivery-controller"
            ]
          },
          "paperclipAttestation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "company", "controller", "runId", "observedAt", "evidenceDigest", "checks"],
            "properties": {
              "source": { "const": "paperclip-company-controller" },
              "company": { "enum": ["Private", "// Navigaite", "Edilio"] },
              "controller": {
                "enum": [
                  "maxbec-delivery-controller",
                  "navigaite-delivery-controller",
                  "edilio-delivery-controller"
                ]
              },
              "runId": { "type": "string", "format": "uuid" },
              "observedAt": { "type": "string", "format": "date-time" },
              "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": ["company", "controller", "lifecycles"],
                "properties": {
                  "company": { "enum": ["compliant", "drift"] },
                  "controller": { "enum": ["compliant", "drift"] },
                  "lifecycles": { "enum": ["compliant", "drift"] }
                }
              }
            }
          },
          "repositories": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "profile", "finalWorkflow"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$" },
                "profile": { "enum": ["fast", "major"] },
                "finalWorkflow": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "key": { "const": "maxbec" },
              "company": { "const": "Private" },
              "githubOwner": { "const": "maxbec" },
              "controller": { "const": "maxbec-delivery-controller" },
              "paperclipAttestation": {
                "type": "object",
                "properties": {
                  "company": { "const": "Private" },
                  "controller": { "const": "maxbec-delivery-controller" }
                },
                "required": ["company", "controller"]
              }
            },
            "required": ["key", "company", "githubOwner", "controller", "paperclipAttestation"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "key": { "const": "navigaite" },
              "company": { "const": "// Navigaite" },
              "githubOwner": { "const": "navigaite" },
              "controller": { "const": "navigaite-delivery-controller" },
              "paperclipAttestation": {
                "type": "object",
                "properties": {
                  "company": { "const": "// Navigaite" },
                  "controller": { "const": "navigaite-delivery-controller" }
                },
                "required": ["company", "controller"]
              }
            },
            "required": ["key", "company", "githubOwner", "controller", "paperclipAttestation"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "key": { "const": "edilio" },
              "company": { "const": "Edilio" },
              "githubOwner": { "const": "edilio" },
              "controller": { "const": "edilio-delivery-controller" },
              "paperclipAttestation": {
                "type": "object",
                "properties": {
                  "company": { "const": "Edilio" },
                  "controller": { "const": "edilio-delivery-controller" }
                },
                "required": ["company", "controller"]
              }
            },
            "required": ["key", "company", "githubOwner", "controller", "paperclipAttestation"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
