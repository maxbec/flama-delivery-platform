{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/paperclip-routine.schema.json",
  "title": "Managed Flama Paperclip routine contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "title", "description", "priority", "initialStatus", "concurrencyPolicy", "catchUpPolicy", "execution", "trigger"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "const": "flama-nightly-reconciliation-v1" },
    "title": { "const": "Flama Nightly Delivery Reconciliation" },
    "description": { "type": "string", "minLength": 100, "maxLength": 2000 },
    "priority": { "const": "low" },
    "initialStatus": { "const": "paused" },
    "concurrencyPolicy": { "const": "coalesce_if_active" },
    "catchUpPolicy": { "const": "skip_missed" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "mode", "evidenceDirectoryEnvironment", "controls"],
      "properties": {
        "command": { "const": "reconcile" },
        "mode": { "const": "read_only" },
        "evidenceDirectoryEnvironment": { "const": "FLAMA_RECONCILIATION_EVIDENCE_DIR" },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queueLagSeconds", "staleClaimSeconds", "authorizationExpiryWarningSeconds", "lookbackSeconds", "maximumAuthorizationRecords"],
          "properties": {
            "queueLagSeconds": { "const": 900 },
            "staleClaimSeconds": { "const": 300 },
            "authorizationExpiryWarningSeconds": { "const": 300 },
            "lookbackSeconds": { "const": 172800 },
            "maximumAuthorizationRecords": { "const": 500 }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "enabled", "timezone", "cronByCompany"],
      "properties": {
        "kind": { "const": "schedule" },
        "label": { "const": "flama-nightly-reconciliation-v1" },
        "enabled": { "const": true },
        "timezone": { "const": "Europe/Berlin" },
        "cronByCompany": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Private", "// Navigaite", "Edilio"],
          "properties": {
            "Private": { "const": "17 1 * * *" },
            "// Navigaite": { "const": "31 1 * * *" },
            "Edilio": { "const": "47 1 * * *" }
          }
        }
      }
    }
  }
}
