{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/secrets-audit-input.schema.json",
  "title": "Secret-safe delivery configuration audit input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "infisical", "publicPullRequest", "destinationSecrets", "exceptions", "repositoryVariables"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "isFork"],
      "properties": {
        "visibility": { "enum": ["private", "public"] },
        "isFork": { "type": "boolean" }
      }
    },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceOfTruth", "projectSlug", "paths", "machineIdentity"],
      "properties": {
        "sourceOfTruth": { "type": "boolean" },
        "projectSlug": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        },
        "machineIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "hardcodedClaims"],
          "properties": {
            "method": { "enum": ["oidc", "workload", "client-secret"] },
            "hardcodedClaims": { "type": "boolean" }
          }
        }
      }
    },
    "publicPullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets", "idToken", "infisical", "trustedCacheWrite", "privateRunner"],
      "properties": {
        "secrets": { "type": "boolean" },
        "idToken": { "type": "boolean" },
        "infisical": { "type": "boolean" },
        "trustedCacheWrite": { "type": "boolean" },
        "privateRunner": { "type": "boolean" }
      }
    },
    "destinationSecrets": {
      "type": "array",
      "items": { "$ref": "#/$defs/destinationSecret" }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "destination", "reason", "owner", "scope", "rotationDays", "expiresAt", "reviewAfter", "status"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "destination": { "enum": ["github_actions_secret", "github_dependabot_secret", "github_environment_secret", "provider_native_secret"] },
          "reason": { "type": "string", "minLength": 20 },
          "owner": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["repository", "environment", "provider"] },
          "rotationDays": { "type": "integer", "minimum": 1, "maximum": 365 },
          "expiresAt": { "type": "string", "format": "date" },
          "reviewAfter": { "type": "string", "format": "date" },
          "status": { "const": "approved" }
        }
      }
    },
    "repositoryVariables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "classification"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "classification": { "enum": ["identifier", "secret_value"] }
        }
      }
    }
  },
  "$defs": {
    "destinationSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "destination"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "destination": { "enum": ["github_actions_secret", "github_dependabot_secret", "github_environment_secret", "provider_native_secret"] }
      }
    }
  }
}
