{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/secrets-audit-input.schema.json",
  "title": "Secret-safe delivery configuration audit input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "infisical", "publicPullRequest", "trustedJobs", "secretSyncs", "destinationSecrets", "exceptions", "repositoryVariables", "generatedConfiguration", "paperclipPrompts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "isFork"],
      "properties": {
        "visibility": { "enum": ["private", "public"] },
        "isFork": { "type": "boolean" }
      }
    },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceOfTruth", "projectSlug", "environmentMappings", "machineIdentity"],
      "properties": {
        "sourceOfTruth": { "type": "boolean" },
        "projectSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" },
        "organization": {
          "$comment": "Infisical organization holding the project, where a company spans more than one.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
        },
        "environmentMappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environment", "paths"],
            "properties": {
              "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$", "maxLength": 512 }
              }
            }
          }
        },
        "machineIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "hardcodedClaims", "shortLived", "sharedAcrossRepositories", "projectScoped", "environmentScoped", "pathScoped", "claims"],
          "properties": {
            "method": { "enum": ["oidc", "workload", "client-secret"] },
            "hardcodedClaims": { "type": "boolean" },
            "shortLived": { "type": "boolean" },
            "sharedAcrossRepositories": { "type": "boolean" },
            "projectScoped": { "type": "boolean" },
            "environmentScoped": { "type": "boolean" },
            "pathScoped": { "type": "boolean" },
            "claims": {
              "type": "object",
              "additionalProperties": false,
              "required": ["issuerExact", "audienceExact", "repositoryExact", "workflowExact", "refOrEnvironmentExact"],
              "properties": {
                "issuerExact": { "type": "boolean" },
                "audienceExact": { "type": "boolean" },
                "repositoryExact": { "type": "boolean" },
                "workflowExact": { "type": "boolean" },
                "refOrEnvironmentExact": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "publicPullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets", "idToken", "infisical", "trustedCacheWrite", "privateRunner", "productionNetwork", "pullRequestTarget"],
      "properties": {
        "secrets": { "type": "boolean" },
        "idToken": { "type": "boolean" },
        "infisical": { "type": "boolean" },
        "trustedCacheWrite": { "type": "boolean" },
        "privateRunner": { "type": "boolean" },
        "productionNetwork": { "type": "boolean" },
        "pullRequestTarget": { "type": "boolean" }
      }
    },
    "trustedJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broadSecretInheritance", "leastPrivilegePath", "buildProductionSecrets", "releaseProductionSecrets", "productionAfterApprovalOnly", "deployApprovalBound"],
      "properties": {
        "broadSecretInheritance": { "type": "boolean" },
        "leastPrivilegePath": { "type": "boolean" },
        "buildProductionSecrets": { "type": "boolean" },
        "releaseProductionSecrets": { "type": "boolean" },
        "productionAfterApprovalOnly": { "type": "boolean" },
        "deployApprovalBound": { "type": "boolean" }
      }
    },
    "secretSyncs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["destination", "targetScope", "allRepositories", "keySelection", "keySchema", "automaticRotation", "initialOverwritePolicy", "connectionCredentialSource"],
        "properties": {
          "destination": { "$ref": "#/$defs/destination" },
          "targetScope": { "enum": ["repository", "environment", "provider"] },
          "allRepositories": { "type": "boolean" },
          "keySelection": { "const": "explicit" },
          "keySchema": { "enum": ["FLAMA_{{environment}}_{{secretKey}}", "destination_native_exact_keys"] },
          "automaticRotation": { "type": "boolean" },
          "initialOverwritePolicy": { "enum": ["source_authoritative", "destination_import_once"] },
          "connectionCredentialSource": { "const": "infisical" }
        }
      }
    },
    "destinationSecrets": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/destinationSecret" }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "destination", "reason", "owner", "scope", "rotationDays", "expiresAt", "reviewAfter", "status"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "destination": { "$ref": "#/$defs/destination" },
          "reason": { "type": "string", "minLength": 20, "maxLength": 1000 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
          "scope": { "enum": ["repository", "environment", "provider"] },
          "rotationDays": { "type": "integer", "minimum": 1, "maximum": 365 },
          "expiresAt": { "type": "string", "format": "date" },
          "reviewAfter": { "type": "string", "format": "date" },
          "status": { "const": "approved" }
        }
      }
    },
    "repositoryVariables": { "$ref": "#/$defs/classifiedNames" },
    "generatedConfiguration": { "$ref": "#/$defs/classifiedNames" },
    "paperclipPrompts": { "$ref": "#/$defs/classifiedNames" }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,119}$" },
    "destination": { "enum": ["github_actions_secret", "github_dependabot_secret", "github_environment_secret", "provider_native_secret"] },
    "destinationSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "destination", "delivery", "rotationDays", "lastRotatedAt"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "destination": { "$ref": "#/$defs/destination" },
        "delivery": { "enum": ["infisical_secret_sync", "approved_destination_exception"] },
        "rotationDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "lastRotatedAt": { "type": "string", "format": "date" }
      }
    },
    "classifiedNames": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "classification"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "classification": { "enum": ["identifier", "secret_value"] }
        }
      }
    }
  }
}
