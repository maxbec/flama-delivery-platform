{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxbec/flama-delivery-platform/schemas/render-input.schema.json",
  "title": "Deterministic consumer template render input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "profile",
    "platformRef",
    "platformVersion",
    "paperclip",
    "release",
    "dependabot",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^(maxbec|navigaite|edilio-app)/[^/]+$"
    },
    "profile": {
      "enum": [
        "fast",
        "major"
      ]
    },
    "platformRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platformVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "paperclip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "projectId",
        "workspaceId",
        "appSlug"
      ],
      "properties": {
        "company": {
          "enum": [
            "Private",
            "// Navigaite",
            "Edilio"
          ]
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "appSlug": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "type",
        "currentVersion"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "node",
            "python",
            "php",
            "flutter",
            "go",
            "simple"
          ]
        },
        "currentVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "dependabot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystems"
      ],
      "properties": {
        "ecosystems": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packageEcosystem",
              "directory"
            ],
            "properties": {
              "packageEcosystem": {
                "enum": [
                  "npm",
                  "pip",
                  "composer",
                  "docker",
                  "github-actions",
                  "pub",
                  "gomod",
                  "gradle",
                  "maven",
                  "cargo"
                ]
              },
              "directory": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildable",
        "affected",
        "full",
        "smoke",
        "health"
      ],
      "properties": {
        "buildable": {
          "$ref": "#/$defs/command"
        },
        "affected": {
          "$ref": "#/$defs/command"
        },
        "full": {
          "$ref": "#/$defs/command"
        },
        "smoke": {
          "$ref": "#/$defs/command"
        },
        "health": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "substituteControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pushGuard"
      ],
      "properties": {
        "pushGuard": {
          "type": "boolean"
        },
        "mergeGate": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
