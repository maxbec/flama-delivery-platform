{
  "name": "flama-delivery-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle:bridge": "bash scripts/build-bridge-bundle.sh",
    "bundle:controller": "bash scripts/build-controller-bundle.sh",
    "bundle:governance": "bash scripts/build-governance-bundle.sh",
    "bundle:cli": "bash scripts/build-cli-bundle.sh",
    "release:build": "node scripts/build-platform-release.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run services/bridge/src/postgres-inbox.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@vercel/ncc": "0.44.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
