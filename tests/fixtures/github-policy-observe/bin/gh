#!/usr/bin/env bash
# Read-only GitHub stub. Every response is a recorded shape of the real API for
# one repository, so the observer is exercised against field names it must not
# invent. Any endpoint the observer is not allowed to call exits non-zero.
set -euo pipefail

if [[ "${1:-}" == "auth" && "${2:-}" == "status" ]]; then
  exit 0
fi

[[ "${1:-}" == "api" ]] || { echo "unexpected mock gh command: $*" >&2; exit 1; }

# Reject any mutating call outright.
for argument in "$@"; do
  case "$argument" in
    -X|--method)
      echo "observer attempted a non-GET request" >&2
      exit 1
      ;;
  esac
done

endpoint=""
for argument in "$@"; do
  case "$argument" in
    -*) ;;
    api) ;;
    *) [[ -n "$endpoint" ]] || endpoint=$argument ;;
  esac
done

emit() { printf '%s\n' "$1"; }

case "$endpoint" in
  repos/maxbec/example)
    emit '{
      "private": false,
      "fork": false,
      "archived": false,
      "default_branch": "'"${FLAMA_GH_DEFAULT_BRANCH:-main}"'",
      "allow_auto_merge": true,
      "delete_branch_on_merge": true,
      "allow_squash_merge": true,
      "allow_merge_commit": false,
      "allow_rebase_merge": false,
      "security_and_analysis": {
        "secret_scanning": {"status": "enabled"},
        "secret_scanning_push_protection": {"status": "enabled"},
        "dependabot_security_updates": {"status": "enabled"}
      }
    }'
    ;;
  repos/maxbec/example/branches/main)
    # A Major-profile repository defaults to dev and keeps main as its stable
    # branch. FLAMA_GH_NO_MAIN models a repository that has no main at all.
    if [[ -n "${FLAMA_GH_NO_MAIN:-}" ]]; then
      echo '{"message": "Branch not found"}' >&2
      exit 1
    fi
    emit '{"name": "main"}'
    ;;
  repos/maxbec/example/branches/dev)
    # A Fast repository has no dev branch at all.
    [[ "${FLAMA_GH_DEFAULT_BRANCH:-main}" == "dev" ]] || {
      echo '{"message": "Branch not found"}' >&2
      exit 1
    }
    emit '{"name": "dev"}'
    ;;
  repos/maxbec/example/branches/dev/protection)
    [[ "${FLAMA_GH_DEFAULT_BRANCH:-main}" == "dev" ]] || {
      echo '{"message": "Branch not protected"}' >&2
      exit 1
    }
    if [[ -n "${FLAMA_GH_NO_PROTECTION:-}" ]]; then
      echo '{"message": "Branch not protected"}' >&2
      exit 1
    fi
    emit '{
      "required_status_checks": {"strict": true, "contexts": ["branch-guard / Flama Branch Guard", "Paperclip Preflight", "policy / Flama Policy Gate"]},
      "required_pull_request_reviews": {"dismiss_stale_reviews": true, "require_code_owner_reviews": true, "require_last_push_approval": true},
      "required_signatures": {"enabled": true},
      "required_conversation_resolution": {"enabled": true},
      "allow_force_pushes": {"enabled": false},
      "allow_deletions": {"enabled": false},
      "restrictions": {"users": [], "teams": [], "apps": []}
    }'
    ;;
  repos/maxbec/example/branches/main/protection)
    if [[ -n "${FLAMA_GH_NO_PROTECTION:-}" ]]; then
      echo '{"message": "Branch not protected"}' >&2
      exit 1
    fi
    emit '{
      "required_status_checks": {"strict": true, "contexts": ["branch-guard / Flama Branch Guard", "Paperclip Preflight", "final / Flama Final Gate"]},
      "required_pull_request_reviews": {"dismiss_stale_reviews": true, "require_code_owner_reviews": true, "require_last_push_approval": true},
      "required_signatures": {"enabled": true},
      "required_conversation_resolution": {"enabled": true},
      "allow_force_pushes": {"enabled": false},
      "allow_deletions": {"enabled": false},
      "restrictions": {"users": [], "teams": [], "apps": []}
    }'
    ;;
  repos/maxbec/example/actions/permissions)
    emit '{"enabled": true, "allowed_actions": "selected"}'
    ;;
  repos/maxbec/example/actions/permissions/selected-actions)
    emit '{
      "github_owned_allowed": true,
      "verified_allowed": true,
      "patterns_allowed": ["maxbec/flama-delivery-platform/*", "maxbec/*"]
    }'
    ;;
  repos/maxbec/example/actions/permissions/workflow)
    emit '{"default_workflow_permissions": "read", "can_approve_pull_request_reviews": false}'
    ;;
  repos/maxbec/example/vulnerability-alerts)
    exit 0
    ;;
  repos/maxbec/example/automated-security-fixes)
    emit '{"enabled": true, "paused": false}'
    ;;
  repos/maxbec/example/rulesets)
    if [[ -n "${FLAMA_GH_RULESETS_FORBIDDEN:-}" ]]; then
      echo '{"message": "Upgrade to GitHub Pro or make this repository public to enable this feature.","status":"403"}' >&2
      exit 1
    fi
    if [[ -n "${FLAMA_GH_RULESETS_BROKEN:-}" ]]; then
      echo '{"message": "Server Error","status":"500"}' >&2
      exit 1
    fi
    emit '[{"id": 55, "target": "tag", "enforcement": "active"}]'
    ;;
  repos/maxbec/example/rulesets/55)
    emit '{
      "id": 55,
      "target": "tag",
      "enforcement": "active",
      "conditions": {"ref_name": {"include": ["refs/tags/v*"], "exclude": []}},
      "rules": [{"type": "deletion"}, {"type": "update"}, {"type": "non_fast_forward"}]
    }'
    ;;
  repos/maxbec/example/contents/.github/CODEOWNERS)
    emit '{"type": "file", "size": 42}'
    ;;
  repos/maxbec/example/contents/.flama/delivery-contract.json*)
    # This repository deploys, so the boundary applies to it.
    emit '{"type": "file", "content": "eyJkZXBsb3ltZW50Ijp7ImRlcGxveWFibGUiOnRydWUsIm1hbmlmZXN0UGF0aCI6Ii5kZXBsb3kvcHJvZHVjdGlvbi55YW1sIn19"}'
    ;;
  repos/maxbec/example/environments)
    emit '{"environments": [{"name": "production"}]}'
    ;;
  repos/maxbec/example/environments/production)
    emit '{"name": "production",
      "protection_rules": [{"type": "required_reviewers", "reviewers": [{"type": "User", "reviewer": {"login": "maxbec"}}]}],
      "deployment_branch_policy": {"protected_branches": true, "custom_branch_policies": false}}'
    ;;
  repos/maxbec/example/git/trees/main*|repos/maxbec/example/git/trees/dev*)
    emit '{"truncated": false, "tree": [{"path": ".github/workflows/delivery.yml"}]}'
    ;;
  repos/maxbec/example/contents/.github/workflows/delivery.yml)
    # base64 of a workflow using a full-SHA third-party pin, no pull_request_target,
    # and a cross-repository reusable workflow the allow-list has to authorize.
    emit "{\"type\": \"file\", \"content\": \"$(printf 'on:\n  pull_request:\njobs:\n  gate:\n    uses: maxbec/flama-delivery-platform/.github/workflows/reusable-policy.yml@11bd71901bbe5b1630ceea73d27597364c9af683\n  build:\n    steps:\n      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n' | base64 -w0)\"}"
    ;;
  *)
    echo "unexpected mock gh API endpoint: $endpoint" >&2
    exit 1
    ;;
esac
